# Database Connection URL (Targeting the MySQL docker service)
DATABASE_URL=mysql://starpoint_user:starpoint_password_here@mysql:3306/starpoint_db

# Redis Caching Connection URL
REDIS_URL=redis://redis:6379

# RabbitMQ Event Queue Connection URL
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Security tokens config
JWT_SECRET=supersecretjwtkeyhere123456789!
JWT_REFRESH_SECRET=supersecretrefreshjwtkeyhere987654321!
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=604800

# Port for NestJS backend inside the container
PORT=3000

# SMTP Mail configurations for Password Reset emails
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=sample_email@gmail.com
MAIL_PASS=sample_smtp_password
MAIL_FROM="StarPoint Support <noreply@starpoint.edu.vn>"
